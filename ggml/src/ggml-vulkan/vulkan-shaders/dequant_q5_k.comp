#version 450

#include "dequant_head.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
layout (binding = 1) writeonly buffer D {uvec4 data_b4[];};   // 8 f16 per element

// Coalesced: each invocation produces 8 consecutive values (one group of a 256-value super-block)
// and writes them as one 16-byte store, so a subgroup writes 512 contiguous bytes per store.
// The dispatch is unchanged: a 32-invocation workgroup covers 256 super-blocks (8192 groups).
void main() {
    for (uint it = 0; it < 256; it++) {
        const uint c = gl_WorkGroupID.x * 8192 + it * 32 + gl_LocalInvocationID.x;
        if (c * 8 >= p.nel) {
            return;
        }
        const uint ib = c / 32;   // super-block
        const uint g = c % 32;    // group of 8 values in it
        float v[8];
        const uint il = g / 8;
        const uint hf = (g % 8) / 4;
        const uint r0 = 8 * (g % 4);
        const uint is = 2 * il;
        const float dall = float(data_a[ib].dm.x);
        const float dmin = float(data_a[ib].dm.y);

        uint scidx0 = (is < 4) ? is : (is + 4);
        uint scidx1 = (is < 4) ? is : (is - 4);
        uint scidxmask1 = (is < 4) ? 0x30 : 0xC0;
        uint scidxshift1 = (is < 4) ? 0 : 2;
        uint mbidx0 = is + 4;
        uint mbidx1 = (is < 4) ? is + 4 : is;
        uint mbidxmask0 = (is < 4) ? 0xF : 0xF0;
        uint mbidxshift0 = (is < 4) ? 0 : 4;
        uint mbidxmask1 = (is < 4) ? 0x30 : 0xC0;
        uint mbidxshift1 = (is < 4) ? 0 : 2;
        uint sc = (data_a[ib].scales[scidx0] & 0xF) | ((data_a[ib].scales[scidx1] & scidxmask1) >> scidxshift1);
        uint mbyte = (data_a[ib].scales[mbidx0] & mbidxmask0) >> mbidxshift0 | ((data_a[ib].scales[mbidx1] & mbidxmask1) >> mbidxshift1);
        const float d1 = dall * float(uint8_t(sc));
        const float m1 = dmin * float(uint8_t(mbyte));

        scidx0 = (is < 4) ? is + 1 : (is + 5);
        scidx1 = (is < 4) ? is + 1 : (is - 3);
        mbidx0 = is + 5;
        mbidx1 = (is < 4) ? is + 5 : is + 1;
        sc = (data_a[ib].scales[scidx0] & 0xF) | ((data_a[ib].scales[scidx1] & scidxmask1) >> scidxshift1);
        mbyte = (data_a[ib].scales[mbidx0] & mbidxmask0) >> mbidxshift0 | ((data_a[ib].scales[mbidx1] & mbidxmask1) >> mbidxshift1);
        const float d2 = dall * float(uint8_t(sc));
        const float m2 = dmin * float(uint8_t(mbyte));

        const float dh = hf == 0 ? d1 : d2;
        const float mh = hf == 0 ? m1 : m2;
        [[unroll]] for (uint j = 0; j < 8; j++) {
            const uint hb = (data_a[ib].qh[r0 + j] >> (2 * il + hf)) & 1;
            v[j] = dh * float(((data_a[ib].qs[32 * il + r0 + j] >> (4 * hf)) & 0xF) + 16 * hb) - mh;
        }
        data_b4[c] = uvec4(packHalf2x16(vec2(v[0], v[1])), packHalf2x16(vec2(v[2], v[3])),
                           packHalf2x16(vec2(v[4], v[5])), packHalf2x16(vec2(v[6], v[7])));
    }
}
