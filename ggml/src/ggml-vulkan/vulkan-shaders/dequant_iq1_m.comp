#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_iq1_m data_a[];};
layout (binding = 1) writeonly buffer D {uvec4 data_b4[];};   // 8 f16 per element

// Coalesced: each invocation produces one 8-value group of a 32-value sub-block and writes it
// as one 16-byte store, so a subgroup writes 512 contiguous bytes per store.  The dispatch is
// unchanged: a workgroup covers 32 super-blocks (8192 values), 4 groups per invocation.
vec4 sgn4(uint s) {
    return vec4((s & 1u) != 0 ? -1.0 : 1.0, (s & 2u) != 0 ? -1.0 : 1.0,
                (s & 4u) != 0 ? -1.0 : 1.0, (s & 8u) != 0 ? -1.0 : 1.0);
}

void main() {
    init_iq_shmem(gl_WorkGroupSize);

    [[unroll]] for (uint h = 0; h < 4; h++) {
        const uint c = gl_WorkGroupID.x * 1024 + h * 256 + gl_LocalInvocationID.x;
        if (c * 8 >= p.nel) {
            return;
        }
        const uint ib = c / 32;
        const uint is = (c % 32) / 4;   // 32-value sub-block
        const uint l = c % 4;           // 8-value group in it
        vec4 v0, v1;
        const uint ib64 = is / 2;
        const uint16_t[4] scales = data_a[ib].scales;
        const u16vec4 s = u16vec4(scales[0], scales[1], scales[2], scales[3]) >> 12;
        const float d = float(unpackHalf2x16(s.x | (s.y << 4) | (s.z << 8) | (s.w << 12)).x);
        const uint sc = data_a[ib].scales[ib64];
        const uint ib16 = 2 * is + l / 2;
        const float dl = d * (2 * bitfieldExtract(sc, 3 * int(ib16 & 3), 3) + 1);
        const uint qh = data_a[ib].qh[ib16] >> (4 * (l & 1));
        const uint qs = data_a[ib].qs[4 * is + l];
        const float delta = ((qh & 8) != 0) ? -IQ1M_DELTA : IQ1M_DELTA;
        const int16_t grid = int16_t(iq1s_grid[qs | ((qh & 7) << 8)]);
        [[unroll]] for (int j = 0; j < 4; ++j) {
            v0[j] = dl * (bitfieldExtract(grid, 2*j, 2) + delta);
            v1[j] = dl * (bitfieldExtract(grid, 2*j + 8, 2) + delta);
        }
        data_b4[c] = uvec4(packHalf2x16(v0.xy), packHalf2x16(v0.zw), packHalf2x16(v1.xy), packHalf2x16(v1.zw));
    }
}
