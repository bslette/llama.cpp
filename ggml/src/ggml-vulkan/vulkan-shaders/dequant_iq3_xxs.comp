#version 450

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_iq3_xxs data_a[];};
layout (binding = 1) writeonly buffer D {uvec4 data_b4[];};   // 8 f16 per element

// Coalesced: each invocation produces one 8-value group of a 32-value sub-block and writes it
// as one 16-byte store, so a subgroup writes 512 contiguous bytes per store.  The dispatch is
// unchanged: a workgroup covers 32 super-blocks (8192 values), 4 groups per invocation.
vec4 sgn4(uint s) {
    return vec4((s & 1u) != 0 ? -1.0 : 1.0, (s & 2u) != 0 ? -1.0 : 1.0,
                (s & 4u) != 0 ? -1.0 : 1.0, (s & 8u) != 0 ? -1.0 : 1.0);
}

void main() {
    init_iq_shmem(gl_WorkGroupSize);

    [[unroll]] for (uint h = 0; h < 4; h++) {
        const uint c = gl_WorkGroupID.x * 1024 + h * 256 + gl_LocalInvocationID.x;
        if (c * 8 >= p.nel) {
            return;
        }
        const uint ib = c / 32;
        const uint is = (c % 32) / 4;   // 32-value sub-block
        const uint l = c % 4;           // 8-value group in it
        vec4 v0, v1;
        const uint s_idx = QUANT_K / 4 + 4 * is;
        const float d = float(data_a[ib].d);
        const uint signscale = pack32(u8vec4(data_a[ib].qs[s_idx + 0], data_a[ib].qs[s_idx + 1],
                                             data_a[ib].qs[s_idx + 2], data_a[ib].qs[s_idx + 3]));
        const float db = d * (0.5 + (signscale >> 28)) * 0.5;
        const uint sign7 = bitfieldExtract(signscale, 7 * int(l), 7);
        const uint sign8 = sign7 | (bitCount(sign7) << 7); // parity bit
        const uint qs0 = data_a[ib].qs[8 * is + 2 * l];
        const uint qs1 = data_a[ib].qs[8 * is + 2 * l + 1];
        v0 = vec4(unpack8(iq3xxs_grid[qs0])) * db * sgn4(sign8);
        v1 = vec4(unpack8(iq3xxs_grid[qs1])) * db * sgn4(sign8 >> 4);
        data_b4[c] = uvec4(packHalf2x16(v0.xy), packHalf2x16(v0.zw), packHalf2x16(v1.xy), packHalf2x16(v1.zw));
    }
}
