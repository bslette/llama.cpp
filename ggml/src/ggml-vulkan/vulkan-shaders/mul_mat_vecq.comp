#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require
#ifdef A_BDA
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#endif

#define MMQ
#define NEEDS_IQ1S_GRID_GPU
#define KVALUES_IQ4NL_I8
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#if defined(DATA_A_Q2_0) || defined(DATA_A_QUANT_K)
#define K_PER_ITER 16
#elif defined(DATA_A_QUANT_LEGACY) || defined(DATA_A_MXFP4)
#define K_PER_ITER 8
#elif defined(DATA_A_IQ1_S) || defined(DATA_A_IQ1_M) || defined(DATA_A_IQ4_XS)
#define K_PER_ITER 32
#else
#error unimplemented
#endif

uint a_offset, b_offset, d_offset;

#ifdef USE_SUBGROUP_ADD_NO_SHMEM
// Each subgroup of the workgroup computes its own rows, so a workgroup can hold
// several subgroups without a shared-memory reduction or a barrier.
#define ROW_THREADS gl_SubgroupSize
#define ROW_TID gl_SubgroupInvocationID
#define ROW_GROUPS gl_NumSubgroups
#define ROW_GROUP gl_SubgroupID
#else
#define ROW_THREADS BLOCK_SIZE
#define ROW_TID gl_LocalInvocationID.x
#define ROW_GROUPS 1
#define ROW_GROUP 0
#endif

// q8_1 quants as 16-byte vectors
layout (binding = 1) readonly buffer B_PACKED128 {block_q8_1_x4_packed128 data_b_packed128[];};

int32_t cache_b_qs[K_PER_ITER / 4];
vec2 cache_b_ds;

#include "mul_mat_vecq_funcs.glsl"

#if !defined(MUL_MAT_ID) && defined(USE_SUBGROUP_ADD_NO_SHMEM)
// MUL_MAT(up) + MUL_MAT(gate) + SWIGLU: the gate matrix is read through the A
// binding, gate_delta blocks after A, and the result is silu(gate) * up.
#define GLU_FUSION
layout (constant_id = 3) const bool FUSE_GLU = false;
FLOAT_TYPE temp_gate[NUM_COLS][NUM_ROWS];
uint gate_delta;
#endif

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        // Preload data_b block
        const uint b_block_idx = (j*p.batch_stride_b + col) / QUANT_K_Q8_1 + b_offset;
        const uint b_block_idx_outer = b_block_idx / 4;
        const uint b_block_idx_inner = b_block_idx % 4;
        cache_b_ds = vec2(data_b[b_block_idx_outer].ds[b_block_idx_inner]);

#if QUANT_R == 2
        // Assumes K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx + 4];
#else
#if K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2 + 1];
#elif K_PER_ITER == 16
        const ivec4 qs = data_b_packed128[b_block_idx_outer].qs[b_block_idx_inner * 2 + b_qs_idx];
        cache_b_qs[0] = qs.x;
        cache_b_qs[1] = qs.y;
        cache_b_qs[2] = qs.z;
        cache_b_qs[3] = qs.w;
#elif K_PER_ITER == 32
        const ivec4 qs0 = data_b_packed128[b_block_idx_outer].qs[b_block_idx_inner * 2];
        const ivec4 qs1 = data_b_packed128[b_block_idx_outer].qs[b_block_idx_inner * 2 + 1];
        cache_b_qs[0] = qs0.x;
        cache_b_qs[1] = qs0.y;
        cache_b_qs[2] = qs0.z;
        cache_b_qs[3] = qs0.w;
        cache_b_qs[4] = qs1.x;
        cache_b_qs[5] = qs1.y;
        cache_b_qs[6] = qs1.z;
        cache_b_qs[7] = qs1.w;
#else
#error unimplemented
#endif
#endif

        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
            ibi += p.ncols;

            temp[j][n] += mmvq_dot_product(a_block_idx, b_qs_idx);
#ifdef GLU_FUSION
            if (FUSE_GLU) {
                temp_gate[j][n] += mmvq_dot_product(a_block_idx + gate_delta, b_qs_idx);
            }
#endif
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = ROW_TID;

    get_offsets(a_offset, b_offset, d_offset);
#ifdef GLU_FUSION
    a_offset += p.a_offset_x;
    gate_delta = p.gate_delta * (QUANT_K / QUANT_K_Q8_1);
#endif
    a_offset *= QUANT_K / QUANT_K_Q8_1;
    b_offset /= QUANT_K_Q8_1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
#ifdef GLU_FUSION
            temp_gate[j][n] = FLOAT_TYPE(0.0f);
#endif
        }
    }

    const uint col_stride = K_PER_ITER * ROW_THREADS;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
        num_iters++;
    }

    const uint b_qs_idx = tid % (32 / K_PER_ITER);
    uint col = tid * K_PER_ITER;
    while (num_iters >= 4) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            iter(temp, first_row, num_rows, col, b_qs_idx);
            col += col_stride;
        }

        num_iters -= 4;
    }

    if (num_iters >= 2) {
        // Manually partially unroll the loop
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        num_iters -= 2;
    }

    if (num_iters > 0) {
        iter(temp, first_row, num_rows, col, b_qs_idx);
    }

#ifdef GLU_FUSION
    if (FUSE_GLU) {
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            [[unroll]] for (uint n = 0; n < num_rows; ++n) {
                const FLOAT_TYPE up = subgroupAdd(temp[j][n]);
                const FLOAT_TYPE gate = subgroupAdd(temp_gate[j][n]);
                if (tid == 0) {
                    data_d[j*p.batch_stride_d + d_offset + first_row + n] = D_TYPE(gate / (1.0f + exp(-gate)) * up);
                }
            }
        }
        return;
    }
#endif
    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * ((gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z) * ROW_GROUPS + ROW_GROUP);

#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
