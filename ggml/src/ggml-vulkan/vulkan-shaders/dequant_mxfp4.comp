#version 450

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_mxfp4 data_a[];};
layout (binding = 1) writeonly buffer D {uvec4 data_b4[];};   // 8 f16 per element

// Each invocation writes two chunks of 8 consecutive f16 as one 16-byte store each, so a
// subgroup writes 512 contiguous bytes per store.  A 32-value block is 4 chunks: low nibbles
// of qs[0..7], low of qs[8..15], high of qs[0..7], high of qs[8..15].  The dispatch is
// unchanged: a workgroup covers 4096 values.
void main() {
    init_iq_shmem(gl_WorkGroupSize);

    [[unroll]] for (uint h = 0; h < 2; h++) {
        const uint c = gl_WorkGroupID.x * 512 + h * 256 + gl_LocalInvocationID.x;
        if (c * 8 >= p.nel) {
            return;
        }
        const uint ib = c / 4;
        const uint t  = c % 4;
        const float d = e8m0_to_fp32(data_a[ib].e) * 0.5;
        const uint q = (t & 1) * 8;
        const uint sh = (t >> 1) * 4;
        vec4 v0, v1;
        [[unroll]] for (uint l = 0; l < 4; l++) {
            v0[l] = float(kvalues_mxfp4[(uint(data_a[ib].qs[q + l]) >> sh) & 0xF]);
            v1[l] = float(kvalues_mxfp4[(uint(data_a[ib].qs[q + 4 + l]) >> sh) & 0xF]);
        }
        v0 *= d;
        v1 *= d;
        data_b4[c] = uvec4(packHalf2x16(v0.xy), packHalf2x16(v0.zw), packHalf2x16(v1.xy), packHalf2x16(v1.zw));
    }
}
