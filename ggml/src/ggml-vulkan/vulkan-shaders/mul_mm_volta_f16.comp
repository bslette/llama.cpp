#version 450

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require

// D = A * B^T for f16 A [M][K] and B [N][K] (both K-contiguous, as after dequantizing src0 and
// converting src1), f32 D column-major in M (ggml dst: D[n * stride_d + m]).  Tuned for Volta
// (HMMA.884 with f16 accumulators): BM x BN block tile (128x128 by default), BK = 32,
// WARPS_M x WARPS_N subgroups (2 x 4 by default), 64x32 per subgroup.  The next K tile is
// loaded into registers while the current one is multiplied from shared memory; shared memory
// is double-buffered, so each K step needs one barrier.  Requires M, N multiples of BM, BN and
// K, strides multiples of 32.
#ifndef BM
#define BM 128
#define BN 128
#define WARPS_M 2
#define WARPS_N 4
#endif
#define THREADS (32 * WARPS_M * WARPS_N)
layout(local_size_x = THREADS, local_size_y = 1, local_size_z = 1) in;

#if defined(A_Q4_0)
// A read in place as ggml blocks (one 32-weight block per row per K tile) and dequantized to f16
// while it is staged into shared memory: two invocations per row, each half a block.
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#define A_QUANT 1
layout (binding = 0) readonly buffer A {uint16_t data_a[];};
const uint QBLK = 9;   // uint16 per block_q4_0: d, 16 bytes of nibbles
const uint QW = 4;     // uint16 of nibbles per invocation
#else
layout (binding = 0) readonly buffer A {uvec4 data_a[];};   // 8 f16 per element
#endif
layout (binding = 1) readonly buffer B {uvec4 data_b[];};
layout (binding = 2) writeonly buffer D {float data_d[];};

layout (push_constant) uniform parameter {
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;
} p;

const uint BK = 32;
const uint RP = THREADS / 4;           // rows staged per pass, 8 f16 per invocation
const uint PA = BM / RP, PB = BN / RP;  // passes for A and B
const uint PITCH = BK + 8;   // f16 per shared row, padded against bank conflicts
shared float16_t sa[2][BM * PITCH];
shared float16_t sb[2][BN * PITCH];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint warp = gl_SubgroupID;
    const uint wm = warp % WARPS_M, wn = warp / WARPS_M;
    const uint m0 = gl_WorkGroupID.y * BM, n0 = gl_WorkGroupID.x * BN;
    const uint ka = p.stride_a / 8, kb = p.stride_b / 8;
    const uint lr = tid / 4, lc = tid % 4;   // rows lr + RP * i, 8 f16 at column 8 * lc

#ifdef A_QUANT
    const uint ar = tid / 2, ah = tid % 2;   // A rows ar + RQ * q, half ah of their block
    const uint RQ = THREADS / 2, QP = BM / RQ;
    const uint nblk = p.stride_a / 32;
    uint qd[QP], qa[QP][QW];
    [[unroll]] for (uint q = 0; q < QP; q++) {
        const uint base = (m0 + ar + RQ * q) * nblk * QBLK;
        qd[q] = uint(data_a[base]);
        [[unroll]] for (uint j = 0; j < QW; j++) {
            qa[q][j] = uint(data_a[base + 1 + QW * ah + j]);
        }
    }
    uvec4 rb[PB];
    [[unroll]] for (uint i = 0; i < PB; i++) {
        rb[i] = data_b[(n0 + lr + RP * i) * kb + lc];
    }
#else
    uvec4 ra[PA], rb[PB];
    [[unroll]] for (uint i = 0; i < PA; i++) {
        ra[i] = data_a[(m0 + lr + RP * i) * ka + lc];
    }
    [[unroll]] for (uint i = 0; i < PB; i++) {
        rb[i] = data_b[(n0 + lr + RP * i) * kb + lc];
    }
#endif
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[4][2];
    [[unroll]] for (uint i = 0; i < 4; i++) [[unroll]] for (uint j = 0; j < 2; j++) {
        acc[i][j] = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0hf);
    }

    const uint ktiles = p.K / BK;
    uint buf = 0;
    for (uint kt = 0; kt < ktiles; kt++) {
#ifdef A_QUANT
        {
            // (0x6400 | n) is the f16 1024 + n, so the weights come out of one HADD2 and one
            // HMUL2 per pair, exactly as (n - 8) * d rounded to f16.
          [[unroll]] for (uint q = 0; q < QP; q++) {
            const f16vec2 dd = f16vec2(unpackFloat2x16(qd[q]).x);
            const uint o = (ar + RQ * q) * PITCH;
            [[unroll]] for (uint j = 0; j < QW; j++) {
                const uint v = qa[q][j];
                const uint lo = (v & 0xFu) | ((v & 0xF00u) << 8);
                const uint hi = ((v >> 4) & 0xFu) | ((v & 0xF000u) << 4);
                const f16vec2 wl = (unpackFloat2x16(lo | 0x64006400u) - f16vec2(1032.0hf)) * dd;
                const f16vec2 wh = (unpackFloat2x16(hi | 0x64006400u) - f16vec2(1032.0hf)) * dd;
                sa[buf][o + 8 * ah + 2 * j] = wl.x; sa[buf][o + 8 * ah + 2 * j + 1] = wl.y;
                sa[buf][o + 16 + 8 * ah + 2 * j] = wh.x; sa[buf][o + 16 + 8 * ah + 2 * j + 1] = wh.y;
            }
          }
        }
        [[unroll]] for (uint i = 0; i < PB; i++) {
            const uint o = (lr + RP * i) * PITCH + lc * 8;
            [[unroll]] for (uint w = 0; w < 4; w++) {
                const f16vec2 y = unpackFloat2x16(rb[i][w]);
                sb[buf][o + 2 * w] = y.x; sb[buf][o + 2 * w + 1] = y.y;
            }
        }
#else
        [[unroll]] for (uint i = 0; i < PA; i++) {
            const uint o = (lr + RP * i) * PITCH + lc * 8;
            [[unroll]] for (uint w = 0; w < 4; w++) {
                const f16vec2 x = unpackFloat2x16(ra[i][w]);
                sa[buf][o + 2 * w] = x.x; sa[buf][o + 2 * w + 1] = x.y;
            }
        }
        [[unroll]] for (uint i = 0; i < PB; i++) {
            const uint o = (lr + RP * i) * PITCH + lc * 8;
            [[unroll]] for (uint w = 0; w < 4; w++) {
                const f16vec2 y = unpackFloat2x16(rb[i][w]);
                sb[buf][o + 2 * w] = y.x; sb[buf][o + 2 * w + 1] = y.y;
            }
        }
#endif
        barrier();
        if (kt + 1 < ktiles) {
            const uint kk = (kt + 1) * (BK / 8);
#ifdef A_QUANT
            [[unroll]] for (uint q = 0; q < QP; q++) {
                const uint base = ((m0 + ar + RQ * q) * nblk + kt + 1) * QBLK;
                qd[q] = uint(data_a[base]);
                [[unroll]] for (uint j = 0; j < QW; j++) {
                    qa[q][j] = uint(data_a[base + 1 + QW * ah + j]);
                }
            }
            [[unroll]] for (uint i = 0; i < PB; i++) {
                rb[i] = data_b[(n0 + lr + RP * i) * kb + kk + lc];
            }
#else
            [[unroll]] for (uint i = 0; i < PA; i++) {
                ra[i] = data_a[(m0 + lr + RP * i) * ka + kk + lc];
            }
            [[unroll]] for (uint i = 0; i < PB; i++) {
                rb[i] = data_b[(n0 + lr + RP * i) * kb + kk + lc];
            }
#endif
        }
        [[unroll]] for (uint ks = 0; ks < BK; ks += 16) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa[4];
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fb[2];
            [[unroll]] for (uint i = 0; i < 4; i++) {
                coopMatLoad(fa[i], sa[buf], (wm * 64 + i * 16) * PITCH + ks, PITCH, gl_CooperativeMatrixLayoutRowMajor);
            }
            [[unroll]] for (uint j = 0; j < 2; j++) {
                coopMatLoad(fb[j], sb[buf], (wn * 32 + j * 16) * PITCH + ks, PITCH, gl_CooperativeMatrixLayoutColumnMajor);
            }
            [[unroll]] for (uint i = 0; i < 4; i++) [[unroll]] for (uint j = 0; j < 2; j++) {
                acc[i][j] = coopMatMulAdd(fa[i], fb[j], acc[i][j]);
            }
        }
        buf ^= 1;
    }
    [[unroll]] for (uint i = 0; i < 4; i++) [[unroll]] for (uint j = 0; j < 2; j++) {
        coopMatStore(coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc[i][j]), data_d,
                     (n0 + wn * 32 + j * 16) * p.stride_d + m0 + wm * 64 + i * 16, p.stride_d,
                     gl_CooperativeMatrixLayoutColumnMajor);
    }
}
